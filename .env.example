# ── Shared Hoppy Tech Supabase ─────────────────────────────────
# Prefer either HT_* or plain SUPABASE_* (both work after redeploy).
HT_SUPABASE_PROJECT_URL=https://your-project.supabase.co
HT_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server-only — never expose to the browser
HT_SUPABASE_SECRET_KEY=your_secret_key
# Aliases also accepted:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ── Email (Resend) ─────────────────────────────────────────────
HT_RESEND_API_KEY=
RESEND_FROM=Hoppy Tech Intake <hello@hoppytech.com>
# Comma-separated if you need multiple recipients
RESEND_TO=jeremy@hoppytech.com

# ── Admin ──────────────────────────────────────────────────────
ADMIN_EMAIL=jeremy@hoppytech.com

# ── Gemini (chatbot + contact screening) ───────────────────────
HT_GEMINI_API_KEY=

# ── Optional tuning ────────────────────────────────────────────
# Set to "off" to bypass Gemini screening on contact + refer forms.
CONTACT_SCREENING=on
# Per-IP hourly cap for contact (clamped to HARD_LIMITS.FORM_PER_IP_HOUR = 8).
CONTACT_RATE_LIMIT_PER_HOUR=5
# Optional tighter caps for refer / shared form guard (also clamped ≤ 8).
# FORM_RATE_LIMIT_PER_HOUR=5
# FORM_MIN_GAP_MS=30000

# Local API server only
PORT=3001

# ── Not currently used (left unset) ────────────────────────────
# GOOGLE_ADS_WEBHOOK_KEY=
# RESEND_DESIGN_TO=
# ZEROBOUNCE_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GITHUB_TOKEN=
